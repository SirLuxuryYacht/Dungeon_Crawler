[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_lnxoq"]
size = Vector2(640, 840)
expression = "float direction_1 = 2.0 * PI * scroll_direction_1 / 360.0;
float direction_2 = 2.0 * PI * scroll_direction_2 / 360.0;


float c_1 = cos(direction_1);
float s_1 = sin(direction_1);

float c_2 = cos(direction_2);
float s_2 = sin(direction_2);

vec2 uv_1 = uv_in;
vec2 uv_2 = uv_in;

uv_1 = vec2(uv_1.x * c_1 + uv_1.y * s_1,-uv_1.x * s_1 + uv_1.y * c_1);

uv_2 = vec2(uv_2.x * c_2 + uv_2.y * s_2,-uv_2.x * s_2 + uv_2.y * c_2);

uv_1.x += scroll_speed_1 / 500.0 * TIME;
uv_2.x += scroll_speed_2 / 500.0 * TIME;

uv_out_1 = uv_1;

uv_out_2 = uv_2;"

